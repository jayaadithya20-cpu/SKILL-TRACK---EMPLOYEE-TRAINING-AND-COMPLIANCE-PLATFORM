PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skilltrack
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Renewal reminders (cron syntax). Default: every day at 09:00
REMINDER_CRON=0 9 * * *
REMINDER_WINDOW_DAYS=30

# Optional SMTP. If SMTP_HOST is empty, emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SkillTrack <no-reply@skilltrack.local>"
